# Database
DATABASE_URL="postgresql://humanstamp:humanstamp_dev@localhost:5432/humanstamp"

# Base URL (for magic links and sign-off URLs)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Session secret (generate with: openssl rand -hex 32)
JWT_SECRET="dev-secret-change-in-production"

# Signing keys (optional in dev, required in production)
# Generate with: node -e "const { generateKeyPair } = require('@human-stamp/core'); generateKeyPair().then(console.log);"
# SIGNING_PRIVATE_KEY=""
# SIGNING_PUBLIC_KEY=""

# Storage (local or s3)
STORAGE_TYPE="local"
STORAGE_LOCAL_PATH="./storage"

# S3-compatible storage (optional, for production)
# S3_BUCKET=""
# S3_REGION=""
# S3_ENDPOINT=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Email (optional, uses console logging in dev)
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="noreply@humanstamp.app"
